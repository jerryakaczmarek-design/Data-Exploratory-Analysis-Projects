        "ax2.set_xlabel('Student Index (Sorted, Square Root Scale)', fontsize=11, fontweight='bold', color='#2d3436', labelpad=10)\n",
        "ax2.set_ylim(0, 105)\n",
        "\n",
        "# Apply square root scale to replace original linear scaling\n",
        "ax2.set_xscale('function', functions=(np.sqrt, np.square))\n",
        "ax2.set_xticks(tick_values)\n",
        "ax2.grid(True, linestyle='--', alpha=0.5)\n",
        "ax2.legend(loc='lower left', frameon=True, facecolor='white', edgecolor='none')\n",
