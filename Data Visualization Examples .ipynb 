        "# Plot Math Score (Top Subplot) using Indigo\n",
        "ax1.plot(x, s1, color='#648fff', linewidth=2.5, label='Math Score (Sorted Ascending)')\n",
        "ax1.set_ylabel('Math Score', fontsize=11, fontweight='bold', color='#2d3436')\n",
        "ax1.set_ylim(0, 105)\n",
        "# Apply custom non-linear square root scale transform\n",
        "ax1.set_xscale('function', functions=(np.sqrt, np.square))\n",
        "ax1.set_xticks(tick_values)\n",
        "ax1.grid(True, linestyle='--', alpha=0.5)\n",
        "ax1.legend(loc='upper left', frameon=True, facecolor='white', edgecolor='none')\n",
        "ax1.spines['top'].set_visible(False)\n",
        "ax1.spines['right'].set_visible(False)\n",
        "ax1.spines['left'].set_color('#cccccc')\n",
        "ax1.spines['bottom'].set_color('#cccccc')\n",
        "\n",
        "# Plot Reading Score (Bottom Subplot) using Orange and include square root scale in axis label\n",
        "ax2.plot(x, s2, color='#fe6100', linewidth=2.5, label='Reading Score (Sorted Descending)')\n",
