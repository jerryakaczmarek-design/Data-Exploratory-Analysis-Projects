        "\n",
        "# Create a stacked subplot configuration\n",
        "fig, (ax1, ax2) = plt.subplots(nrows=2, ncols=1, figsize=(10, 8), sharex=True)\n",
        "\n",
        "# Define explicit tick marks in the original scale\n",
        "tick_values = np.array([0, 50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 1000])\n",
