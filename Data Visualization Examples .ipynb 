      "source": [
        "# Redesign: Use Sorted Horizontal Bar Chart to replace the cluttered Pie Chart\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.cm as cm\n",
        "\n",
        "# Ensure data and column references are loaded inside this cell\n",
        "df = pd.read_csv('exams.csv')\n",
        "num_cols = df.select_dtypes(include='number').columns.tolist()\n",
        "cat_cols = [c for c in df.columns if df[c].dtype == 'object' or df[c].nunique() <= 12]\n",
        "\n",
        "# Recreate the data presented in Pie Chart\n",
        "if len(cat_cols) > 0 and df[cat_cols[0]].nunique() >= 8:\n",
        "    cat = cat_cols[0]\n",
        "    counts = df[cat].value_counts().head(12)\n",
        "else:\n",
        "    base = num_cols[0] if len(num_cols) > 0 else None\n",
        "    if base:\n",
        "        bins = pd.qcut(df[base], q=12, duplicates='drop')\n",
        "        counts = bins.value_counts()\n",
        "        cat = f'Binned_{base}'\n",
        "    else:\n",
        "        tmp = pd.Series(np.random.choice([f'Group_{i}' for i in range(12)], size=len(df)))\n",
        "        counts = tmp.value_counts()\n",
        "        cat = 'SyntheticGroup'\n",
        "\n",
        "# Convert counts to percentages for easy comprehension\n",
        "percentages = (counts / counts.sum()) * 100\n",
        "\n",
        "# Standardize string index labels to clean spaces\n",
        "percentages.index = percentages.index.astype(str).str.strip()\n",
        "\n",
        "# Sort in ascending order (smallest percentage at the top, largest at the bottom of the chart)\n",
        "percentages = percentages.sort_values(ascending=True)\n",
        "\n",
        "# Convert index labels to clean readable string labels\n",
        "y_labels = []\n",
        "for idx in percentages.index:\n",
        "    idx_str = str(idx).strip()\n",
        "    if \"45.0\" in idx_str and (\"0.00\" in idx_str or \"-0.00\" in idx_str):\n",
        "        y_labels.append(\"[45.0 and Below]\")\n",
        "    else:\n",
        "        y_labels.append(idx_str)\n",
        "\n",
        "# Generate a gradient color array with lightest blue for smallest value, darkest blue for largest value.\n",
        "norm = plt.Normalize(vmin=percentages.min() - 0.5, vmax=percentages.max())\n",
        "colors = cm.Blues(norm(percentages.values))\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 6))\n",
        "bars = ax.barh(y_labels, percentages.values, color=colors, edgecolor='none')\n",
        "\n",
        "# Add percentage values to the end of each bar for precise readability\n",
        "for bar in bars:\n",
        "    width = bar.get_width()\n",
        "    ax.text(width + 0.1, bar.get_y() + bar.get_height()/2, f' {width:.1f}%',\n",
        "            va='center', ha='left', fontsize=10, fontweight='bold', color='#333333')\n",
        "\n",
        "# Remove distracting chart junk to lower cognitive load\n",
        "ax.spines['top'].set_visible(False)\n",
        "ax.spines['right'].set_visible(False)\n",
        "ax.spines['bottom'].set_visible(False)\n",
        "ax.spines['left'].set_color('#cccccc')\n",
        "\n",
        "# Keep the x-axis structure so the label shows, but hide the numerical labels and ticks\n",
        "# to reduce chart noise\n",
        "ax.tick_params(axis='x', which='both', bottom=False, labelbottom=False)\n",
        "\n",
        "# Bold the category labels on the y-axis to see bins more effectively\n",
        "ax.set_yticks(range(len(y_labels)))\n",
        "ax.set_yticklabels(y_labels, fontweight='bold')\n",
        "\n",
        "# Add colored axis titles for clarity and distinct separation of value labels\n",
        "ax.set_xlabel('Percentage of Total Scores', fontsize=8, fontweight='bold', labelpad=15, color='#0f4c5c')\n",
        "ax.set_ylabel('Math Test Score Range', fontsize=8, fontweight='bold', labelpad=10, color='#0f4c5c')\n",
        "\n",
        "# Titles and Labels\n",
        "plt.title('Distribution of Math Scores by Percentage Share', fontsize=14, pad=20, loc='center', fontweight='bold')\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "#Save chart as PNG\n",
        "plt.savefig('distribution_of_math_scores_by_percentage.png', dpi=300, bbox_inches='tight')\n",
        "plt.show()"
